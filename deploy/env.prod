# ============================================
# AI Interview Platform - Production Environment
# 生产环境环境变量配置
# 使用方式: docker compose --env-file deploy/env.prod up -d
# ============================================

# === AI 模型配置 (必须修改) ===
# 替换为你的 AI API Key
AI_BAILIAN_API_KEY=your_api_key_here
# AI 模型名 (当前线上使用 deepseek-chat)
AI_MODEL=deepseek-chat

# === Redis 密码 (生产环境必须设置) ===
REDIS_PASSWORD=123456

# === 跨域配置 ===
# 生产环境需包含 HTTPS 域名
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80,https://edu.zhangyunyu.cn

# === 面试参数配置 ===
APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_EVALUATION_BATCH_SIZE=8
